# Local development environment template
# Copy this file to .env and replace every placeholder with a real value.
# Never commit your real .env file.

# Flask session signing key (use a long random value)
SECRET_KEY=replace-with-a-long-random-secret

# Admin dashboard credentials
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Database
# Render: use the Internal Database URL from your PostgreSQL service.
# Local SQLite fallback: leave DATABASE_URL empty and set USE_SQLITE=1.
DATABASE_URL=
USE_SQLITE=1

# Optional published subdomain support, e.g. example.com
BASE_DOMAIN=

# Public application URL used by hosted payment callbacks
APP_BASE_URL=https://nafiz-ahmed12s.onrender.com

# SSLCommerz hosted checkout
# Use 1 for sandbox/testing; switch to 0 for live production credentials.
SSLCOMMERZ_SANDBOX=1
SSLCOMMERZ_STORE_ID=replace-with-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=replace-with-sslcommerz-store-password

# Payment webhook signing secret for internal payment webhooks
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Session/security settings
SESSION_COOKIE_SECURE=0
MAX_CONTENT_LENGTH=1048576

# SQLAlchemy PostgreSQL connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
