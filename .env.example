# Local development environment template
# Copy this file to .env and replace every placeholder with a real value.
# Never commit your real .env file.

SECRET_KEY=replace-with-a-long-random-secret

# Admin dashboard credentials
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Database
DATABASE_URL=
USE_SQLITE=1

# Optional published subdomain support, e.g. example.com
BASE_DOMAIN=

# Permanent public SEO/canonical domain
PUBLIC_BASE_URL=https://nafizecommerce.com
APP_BASE_URL=https://nafizecommerce.com

# Email delivery (Resend API)
RESEND_API_KEY=replace-with-resend-api-key
MAIL_FROM=replace-with-verified-sender@example.com
MAIL_REPLY_TO=

# SSLCommerz hosted checkout
SSLCOMMERZ_SANDBOX=1
SSLCOMMERZ_STORE_ID=replace-with-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=replace-with-sslcommerz-store-password

# Payment webhook signing secret
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Session/security settings
SESSION_COOKIE_SECURE=1
MAX_CONTENT_LENGTH=1048576

# SQLAlchemy PostgreSQL connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
